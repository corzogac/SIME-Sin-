# SIME Configuration
# Copy this file to .env and adjust values

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Database (PostgreSQL+PostGIS for production, SQLite for local dev)
# For PostgreSQL: postgresql+asyncpg://user:password@localhost:5432/sime
DATABASE_URL=sqlite+aiosqlite:///./data/sime.db

# Open-Meteo (no API key needed, but you can set a custom base URL)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_FLOOD_URL=https://flood-api.open-meteo.com/v1/flood

# OpenWeatherMap (optional, for additional data)
OPENWEATHERMAP_API_KEY=

# DEM data directory
DEM_DATA_DIR=./data/dem

# Colombia bounding box (default)
COLOMBIA_LAT_MIN=-4.23
COLOMBIA_LAT_MAX=13.39
COLOMBIA_LON_MIN=-81.73
COLOMBIA_LON_MAX=-66.85

# Cache TTL in seconds
WEATHER_CACHE_TTL=900
FLOOD_CACHE_TTL=3600

# Logging
LOG_LEVEL=INFO
